# Frontend environment (copy to .env). All vars must be prefixed with VITE_.

# Where the Socket.IO server lives. REST goes through the Vite proxy in dev,
# but WebSockets connect here directly.
VITE_SOCKET_URL=http://localhost:5000

# In dev, leave the REST base as the proxied /api. In a non-proxied deploy set
# this to the full backend URL, e.g. https://api.example.com/api
VITE_API_URL=/api
