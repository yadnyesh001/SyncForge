# -----------------------------------------------------------------------------
# Server environment. Copy to `.env` and adjust. NEVER commit the real .env.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (the Vite dev server, etc.)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (Docker Compose service name is "mongo").
# For MongoDB Atlas use the mongodb+srv://... string from "Connect → Drivers".
MONGO_URI=mongodb://localhost:27017/rt_collab

# Optional: force DNS resolution through public servers. Needed when your network
# refuses the SRV lookup that mongodb+srv:// requires (error: querySrv ECONNREFUSED).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: skip Redis entirely (single-instance dev without Redis running).
# DISABLE_REDIS=1

# Redis connection string (Docker Compose service name is "redis")
REDIS_URL=redis://localhost:6379

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
